<script>
(() => {
    const ready = () => {
        const logEl = document.getElementById('examples2-log-output');
        const analyticsLogEl = document.getElementById('examples2-analytics-log');
        const recsPreview = document.getElementById('examples2-recs-preview');
        const searchInput = document.getElementById('examples2-search-query');
        const publisherButtons = document.querySelectorAll('[data-cross-action]');
        const crossLog = document.getElementById('examples2-cross-log');

        const logLine = (channel, message, target = logEl) => {
            if (!target) {
                return;
            }
            const ts = new Date().toLocaleTimeString();
            target.textContent = `[${ts}] [${channel}] ${message}\n` + target.textContent;
        };

        const flow = window.hyvaflow;
        if (!flow) {
            logLine('error', 'window.hyvaflow is not available. Load hyvaflow-core.js (and optionally the DOM plugin) before this template.');
            return;
        }

        const state = {
            analyticsEnabled: false,
            recsEnabled: false,
            cross: {
                cart: false,
                marketing: false,
                analytics: false,
            },
            listeners: {}
        };

        const setStateDot = (panel, isOn) => {
            const dot = panel.querySelector('.state-dot');
            if (dot) {
                dot.dataset.state = isOn ? 'on' : 'off';
            }
        };

        const toggleAnalytics = () => {
            const panel = document.querySelector('[data-panel="analytics"]');
            if (!panel) return;
            const button = document.getElementById('examples2-toggle-analytics');
            if (!state.analyticsEnabled) {
                const handler = (event) => {
                    logLine('analytics', JSON.stringify(event.detail), analyticsLogEl);
                };
                state.listeners.analytics = handler;
                flow.on('examples2:search', handler);
                state.analyticsEnabled = true;
                button.textContent = 'Disable listener';
                setStateDot(panel, true);
                logLine('bus', 'Analytics listener registered.');
            } else {
                flow.off('examples2:search', state.listeners.analytics);
                state.analyticsEnabled = false;
                button.textContent = 'Enable listener';
                setStateDot(panel, false);
                logLine('bus', 'Analytics listener removed.');
            }
        };

        const toggleRecommendations = () => {
            const panel = document.querySelector('[data-panel="recommendations"]');
            if (!panel) return;
            const button = document.getElementById('examples2-toggle-recs');
            if (!state.recsEnabled) {
                const handler = (event) => {
                    const { query } = event.detail;
                    recsPreview.innerHTML = '<p class="text-sm"><?= $block->escapeJs(__('Rebuilding recommendations for:')) ?> <strong>' +
                        (query || '<?= $block->escapeJs(__('(empty)')) ?>') + '</strong></p>';
                    logLine('recs', `Updated copy for "${query || 'empty'}".`);
                };
                state.listeners.recs = handler;
                flow.on('examples2:search', handler);
                state.recsEnabled = true;
                button.textContent = 'Disable listener';
                setStateDot(panel, true);
                logLine('bus', 'Recommendation listener registered.');
            } else {
                flow.off('examples2:search', state.listeners.recs);
                state.recsEnabled = false;
                button.textContent = 'Enable listener';
                setStateDot(panel, false);
                recsPreview.innerHTML = '<p class="text-sm text-muted"><?= $block->escapeJs(__('No query received yet.')) ?></p>';
                logLine('bus', 'Recommendation listener removed.');
            }
        };

        const broadcastSearch = () => {
            const query = (searchInput?.value || '').trim();
            const payload = {
                query,
                ts: Date.now(),
                source: 'examples2:search',
            };
            flow.trigger('examples2:search', payload);
            logLine('bus', `trigger('examples2:search') => ${JSON.stringify(payload)}`);
        };

        const crossHandlers = {
            cart: (event) => {
                const badge = document.querySelector('[data-cart-count]');
                if (!badge) return;
                const current = Number(badge.textContent) || 0;
                badge.textContent = current + event.detail.quantity;
                logLine('cart', `Cart updated to ${badge.textContent}.`, crossLog);
            },
            marketing: (event) => {
                const copy = document.querySelector('[data-banner-copy]');
                if (!copy) return;
                copy.textContent = `Promo refreshed after ${event.detail.eventName}`;
                logLine('marketing', `Banner copy refreshed (${event.detail.eventName}).`, crossLog);
            },
            analytics: (event) => {
                logLine('analytics', `Captured ${event.detail.eventName}`, crossLog);
            },
        };

        const toggleCrossListener = (key) => {
            const button = document.querySelector(`[data-cross-toggle="${key}"]`);
            const container = document.querySelector(`[data-cross-target="${key}"]`);
            if (!button || !container) return;
            state.cross[key] = !state.cross[key];
            const enabled = state.cross[key];
            button.textContent = enabled ? 'Disable listener' : 'Enable listener';
            setStateDot(container, enabled);
            const handler = state.listeners[key];
            const eventNames = {
                cart: 'examples2:cart:itemAdded',
                marketing: 'examples2:marketing:update',
                analytics: 'examples2:analytics:tap',
            };

            if (enabled) {
                const wrapped = (event) => crossHandlers[key](event);
                state.listeners[key] = wrapped;
                flow.on(eventNames[key], wrapped);
                logLine('bus', `Cross listener for ${eventNames[key]} registered.`);
            } else if (handler) {
                flow.off(eventNames[key], handler);
                logLine('bus', `Cross listener for ${eventNames[key]} removed.`);
            }
        };

        const emitCrossEvent = (action) => {
            const events = {
                cart: {
                    name: 'examples2:cart:itemAdded',
                    detail: { eventName: 'cart:itemAdded', quantity: 1, sku: 'demo-' + Math.random().toString(16).slice(2, 6) },
                },
                wishlist: {
                    name: 'examples2:marketing:update',
                    detail: { eventName: 'wishlist:itemAdded', list: 'favourites' },
                },
                inventory: {
                    name: 'examples2:marketing:update',
                    detail: { eventName: 'inventory:low', sku: 'demo-' + Math.random().toString(16).slice(2, 6) },
                },
            };
            const event = events[action];
            if (!event) return;
            flow.trigger(event.name, event.detail);
            flow.trigger('examples2:analytics:tap', event.detail);
            logLine('publisher', `trigger('${event.name}') => ${JSON.stringify(event.detail)}`);
        };

        document.getElementById('examples2-toggle-analytics')?.addEventListener('click', toggleAnalytics);
        document.getElementById('examples2-toggle-recs')?.addEventListener('click', toggleRecommendations);
        document.getElementById('examples2-search-broadcast')?.addEventListener('click', broadcastSearch);
        document.getElementById('examples2-clear-log')?.addEventListener('click', () => {
            if (logEl) logEl.textContent = '';
        });

        document.querySelectorAll('[data-cross-toggle]').forEach((btn) => {
            btn.addEventListener('click', () => toggleCrossListener(btn.dataset.crossToggle));
        });

        publisherButtons.forEach((btn) => {
            btn.addEventListener('click', () => emitCrossEvent(btn.dataset.crossAction));
        });

        logLine('init', 'Hyvä Flow Examples 2 ready.');
    };

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        ready();
    } else {
        document.addEventListener('DOMContentLoaded', ready, { once: true });
    }
})();
</script>
