<script>
document.addEventListener('alpine:init', () => {
    Alpine.store('hyvaflowDemo', {
        logOutput: '',
        log(channel, message) {
            const ts = new Date().toLocaleTimeString();
            const line = `[${ts}] [${channel}] ${message}\n`;
            this.logOutput = line + this.logOutput;
        },
        flow() {
            const flow = window.hyvaflow;
            if (!flow) {
                this.log('error', 'window.hyvaflow is undefined. Ensure hyvaflow-core.js is loaded.');
            }
            return flow;
        },
        highlight(node, classes = ['ring-4', 'ring-blue-400/70', 'shadow-lg'], duration = 900) {
            if (!node || !node.classList) return;
            node.classList.add(...classes);
            setTimeout(() => node.classList.remove(...classes), duration);
        },
        clearLog() {
            this.logOutput = '';
        }
    });

    /* ---------------- Event Bus & Trigger ---------------- */
    Alpine.data('hyvaFlowEventBusDemo', () => ({
        listenersBound: false,
        snippet: '',

        init() {
            const flow = Alpine.store('hyvaflowDemo').flow();
            if (flow) {
                // Auto-set initial snippet
                this.snippet = `hyvaflow.on('hyva:flow:ready', () => console.log('hyva:flow:ready'));
hyvaflow.on('hyva:flow:dom:refresh', () => console.log('hyva:flow:dom:refresh'));
// Subscribe to Hyvä Flow lifecycle events`;
                Alpine.store('hyvaflowDemo').log('init', 'Hyvä Flow detected. Event bus demo ready.');
            }
        },

        registerListeners(log = true) {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;
            if (this.listenersBound) {
                if (log) store.log('event', 'Listeners already registered.');
                this.snippet = `hyvaflow.on('hyva:flow:ready', handler);
hyvaflow.on('hyva:flow:dom:refresh', handler);
hyvaflow.on('hyva:flow:demo', handler);
// Listeners already registered; no-op on repeat call`;
                return;
            }
            this.listenersBound = true;

            flow.on('hyva:flow:ready', () => store.log('event', 'hyva:flow:ready received.'));
            flow.on('hyva:flow:dom:refresh', () => store.log('event', 'hyva:flow:dom:refresh received.'));
            flow.on('hyva:flow:demo', (event) => {
                store.log('event', `hyva:flow:demo detail => ${JSON.stringify(event.detail || {})}`);
            });

            this.snippet = `hyvaflow.on('hyva:flow:ready', () => console.log('hyva:flow:ready'));
hyvaflow.on('hyva:flow:dom:refresh', () => console.log('hyva:flow:dom:refresh'));
hyvaflow.on('hyva:flow:demo', (event) => console.log(event.detail));
// Register Hyvä Flow listeners for lifecycle and demo events`;

            if (log) store.log('event', 'Demo listeners registered.');
        },

        triggerDemoEvent() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const payload = {
                source: 'demo-template',
                timestamp: Date.now(),
                note: 'Triggered via hyvaflow.trigger from Alpine demo',
            };
            flow.trigger('hyva:flow:demo', payload);

            this.snippet = `hyvaflow.trigger('hyva:flow:demo', {
  source: 'demo-template',
  timestamp: Date.now(),
  note: 'Triggered via hyvaflow.trigger from Alpine demo',
});
// Trigger a Hyvä Flow custom event with a detail payload`;

            store.log('trigger', `hyvaflow.trigger('hyva:flow:demo', ${JSON.stringify(payload)}) called.`);
        },

        emitReady() {
            Alpine.store('hyvaflowDemo').log('lifecycle', 'Dispatching alpine:init.');
            this.snippet = `document.dispatchEvent(new CustomEvent('alpine:init'));
// Dispatch Alpine init event so Hyvä Flow can emit hyva:flow:ready`;
            document.dispatchEvent(new CustomEvent('alpine:init'));
        },

        emitRefresh() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;
            flow.trigger('hyva:flow:dom:refresh');

            this.snippet = `hyvaflow.trigger('hyva:flow:dom:refresh');
// Manually trigger Hyvä Flow DOM refresh event`;

            store.log('lifecycle', 'hyva:flow:dom:refresh dispatched manually.');
        }
    }));

    /* ---------------- DomUtils.select ---------------- */
    Alpine.data('hyvaFlowSelectDemo', () => ({
        selectMessage: '',
        snippet: '',

        init() {
            this.snippet = `const cards = hyvaflow.select('.hyvaflow-demo-card');
// Select all demo cards in this section`;
        },

        toggleCard(event) {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const targetCard = event.target.closest('.hyvaflow-demo-card');
            if (!targetCard) return;

            const cardId = targetCard.getAttribute('data-card');
            if (!cardId) return;

            const [card] = flow.select('[data-card="' + cardId + '"]');
            if (!card) return;

            card.classList.toggle('is-selected');
            const status = card.classList.contains('is-selected') ? 'selected' : 'deselected';
            store.highlight(card);
            store.log('select', `Card ${cardId} ${status} via hyvaflow.select().`);

            this.snippet = `const [card] = hyvaflow.select('[data-card="<id>"]');
card.classList.toggle('is-selected');
// Toggle selection state of a single card using Hyvä Flow selection API`;
        },

        selectCards() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const cards = flow.select('.hyvaflow-demo-card');
            cards.forEach((card, index) => {
                setTimeout(() => store.highlight(card), index * 120);
            });

            const msg = cards.length
                ? `${cards.length} node(s) highlighted via hyvaflow.select('.hyvaflow-demo-card').`
                : 'No nodes matched the selector.';
            this.selectMessage = msg;
            store.log('select', msg);

            this.snippet = `const cards = hyvaflow.select('.hyvaflow-demo-card');
cards.forEach((card) => highlight(card));
// Highlight all demo cards via Hyvä Flow's select() helper`;
        },

        listSelected() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const selectedCards = flow.select('.hyvaflow-demo-card.is-selected').toArray();
            const ids = selectedCards
                .map((card) => card.getAttribute('data-card'))
                .filter(Boolean);

            const msg = ids.length
                ? `Selected cards: ${ids.join(', ')}`
                : 'No cards are currently selected.';

            this.selectMessage = msg;
            store.log('select', msg);

            this.snippet = `const selected = hyvaflow.select('.hyvaflow-demo-card.is-selected').toArray();
// Get the currently selected demo cards as a plain array`;
        }
    }));

    /* ---------------- Selector Chaining Lab ---------------- */
    Alpine.data('hyvaFlowChainingDemo', () => ({
        snippet: '',
        message: '',
        snippets: {
            combined: `const selectedCards = window.hyvaflow.select('.hyvaflow-chain-card.is-selected');
// Select all chain cards that are already marked as .is-selected`,
            filtered: `const warmSelected = window.hyvaflow.select('.hyvaflow-chain-card')
  .toArray()
  .filter((card) => card.classList.contains('is-selected') && card.dataset.tone === 'warm');
// Filter selection in JS to keep only warm + selected cards`,
            misuse: `// Avoid nested select on the same nodes:
window.hyvaflow.select('.hyvaflow-chain-card').select('.is-selected'); // => []
// The second select() searches within each card, not the whole document`,
        },

        init() {
            this.setSnippet('combined');
            this.message = 'Click any card (or the buttons above) to see selector chaining tips.';
        },

        setSnippet(key) {
            this.snippet = this.snippets[key] || this.snippets.combined;
        },

        toggleCard(event) {
            const store = Alpine.store('hyvaflowDemo');
            const card = event.target.closest('[data-chain-card]');
            if (!card) return;

            card.classList.toggle('is-selected');
            const status = card.classList.contains('is-selected') ? 'selected' : 'deselected';
            store.highlight(card);
            this.message = `${(card.dataset.tone || 'Card')} ${status} via direct click.`;
            store.log('chain', this.message);
            this.setSnippet('combined');
        },

        toggleRandom() {
            const store = Alpine.store('hyvaflowDemo');
            const cards = Array.from(document.querySelectorAll('[data-chain-card]'));
            if (!cards.length) {
                this.message = 'Chain demo cards not found.';
                store.log('chain', this.message);
                return;
            }
            const target = cards[Math.floor(Math.random() * cards.length)];
            target.classList.toggle('is-selected');
            const status = target.classList.contains('is-selected') ? 'selected' : 'deselected';
            store.highlight(target);
            this.message = `${(target.dataset.tone || 'Card')} ${status} via toggle button.`;
            store.log('chain', this.message);
            this.setSnippet('combined');
        },

        highlightCombined() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const selection = flow.select('.hyvaflow-chain-card.is-selected');
            if (!selection.length) {
                this.message = 'No cards are currently selected. Click a tile first, then rerun the combined selector.';
                store.log('chain', this.message);
                this.setSnippet('combined');
                return;
            }
            selection.forEach((node) => store.highlight(node));
            this.message = `Combined selector matched ${selection.length} card(s).`;
            store.log('chain', this.message);
            this.setSnippet('combined');
        },

        highlightWarmSelected() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const warmSelected = flow
                .select('.hyvaflow-chain-card')
                .toArray()
                .filter((card) => card.classList.contains('is-selected') && card.dataset.tone === 'warm');

            warmSelected.forEach((node) => store.highlight(node));

            this.message = warmSelected.length
                ? `Filter approach returned ${warmSelected.length} warm + selected card(s).`
                : 'No warm cards are selected right now.';

            store.log('chain', this.message);
            this.setSnippet('filtered');
        },

        showPitfall() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const nested = flow.select('.hyvaflow-chain-card').select('.is-selected');
            this.message = `Chained select returned ${nested.length} because the second call only searches inside each card. Combine selectors or filter instead.`;
            store.log('chain', this.message);
            this.setSnippet('misuse');
        }
    }));

    /* ---------------- Bridges Demo ---------------- */
    Alpine.data('hyvaFlowBridgesDemo', () => ({
        alpineMockEnabled: false,
        snippet: '',

        simulateHtmxSwap() {
            const store = Alpine.store('hyvaflowDemo');
            store.log('htmx', 'Dispatching synthetic htmx:afterSwap event.');
            this.snippet = `document.dispatchEvent(new CustomEvent('htmx:afterSwap'));
// Simulate an HTMX afterSwap lifecycle event`;
            document.dispatchEvent(new CustomEvent('htmx:afterSwap'));
        },

        enableAlpineMock() {
            const store = Alpine.store('hyvaflowDemo');
            if (this.alpineMockEnabled) {
                store.log('alpine', 'Mock Alpine.dispatch already enabled.');
                this.snippet = `// Alpine.dispatch mock is already active
// No additional wrapping required`;
                return;
            }
            this.alpineMockEnabled = true;

            const existing = window.Alpine || {};
            const originalDispatch = typeof existing.dispatch === 'function'
                ? existing.dispatch.bind(existing)
                : null;

            window.Alpine = Object.assign({}, existing, {
                dispatch(event, detail) {
                    store.log('alpine', `Alpine.dispatch -> ${event} | ${JSON.stringify(detail || {})}`);
                    if (originalDispatch) {
                        return originalDispatch(event, detail);
                    }
                    return undefined;
                },
            });

            this.snippet = `window.Alpine = {
  ...window.Alpine,
  dispatch(event, detail) {
    console.log('Alpine.dispatch', event, detail);
  },
};
// Wrap Alpine.dispatch so Hyvä Flow bridge output is visible`;

            store.log('alpine', 'Mock Alpine.dispatch enabled. hyvaflow.trigger will forward payloads here.');
        },

        triggerAlpineEvent() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const detail = { level: 'info', id: Math.random().toString(36).slice(2, 7) };
            flow.trigger('hyva:flow:alpine-demo', detail);

            this.snippet = `hyvaflow.trigger('hyva:flow:alpine-demo', {
  level: 'info',
  id: '<random>',
});
// Trigger a Hyvä Flow event that is forwarded into Alpine.dispatch`;

            store.log('alpine', `hyvaflow.trigger('hyva:flow:alpine-demo') invoked with ${JSON.stringify(detail)}.`);
        }
    }));

    /* ---------------- publicApi Playground ---------------- */
    Alpine.data('hyvaFlowApiDemo', () => ({
        queuedCounter: 0,
        queueListener: false,
        onAliasBound: false,
        applyToggle: false,
        attrStep: 0,
        onEventBound: false,
        snippet: '',

        sampleSelector: '[data-flow-target]',

        init() {
            this.refreshAttrBadges();
            this.snippet = `const selection = hyvaflow.select('[data-flow-target]');
// Base selection used by the public API playground`;
        },

        withTargets(callback) {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const selection = flow.select(this.sampleSelector);
            if (!selection.length) {
                store.log('api', `select('${this.sampleSelector}') returned 0 nodes.`);
                return;
            }
            return callback(selection, flow, store);
        },

        refreshAttrBadges() {
            document.querySelectorAll('[data-flow-target]').forEach((node) => {
                const badge = node.querySelector('[data-flow-attr]');
                if (!badge) return;
                const value = node.getAttribute('data-flow-state') || 'unset';
                badge.textContent = `data-flow-state="${value}"`;
            });
        },

        /* Event queue */
        dispatchQueuedEvent() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            const counter = ++this.queuedCounter;
            flow.dispatchEvent({
                event: 'hyva:flow:queued-demo',
                detail: { counter, via: 'dispatchEvent' },
            });

            this.snippet = `hyvaflow.dispatchEvent({
  event: 'hyva:flow:queued-demo',
  detail: { counter, via: 'dispatchEvent' },
});
// Queue a Hyvä Flow event that will be replayed to listeners`;

            store.log('api', `dispatchEvent queued hyva:flow:queued-demo (#${counter}).`);
        },

        registerQueueListener() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            if (this.queueListener) {
                store.log('api', 'addEventListener already observing hyva:flow:queued-demo.');
                this.snippet = `hyvaflow.addEventListener('hyva:flow:queued-demo', handler);
// Queue listener already registered`;
                return;
            }
            this.queueListener = true;
            flow.addEventListener('hyva:flow:queued-demo', (event) => {
                store.log('api', `addEventListener -> detail ${JSON.stringify(event.detail || {})}`);
            });

            this.snippet = `hyvaflow.addEventListener('hyva:flow:queued-demo', (event) => {
  console.log(event.detail);
});
// Listen for queued Hyvä Flow events`;

            store.log('api', 'addEventListener registered for hyva:flow:queued-demo.');
        },

        bindOnAlias() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            if (this.onAliasBound) {
                store.log('api', 'on() listener already registered for hyva:flow:on-lab.');
                this.snippet = `hyvaflow.on('hyva:flow:on-lab', handler);
// on() listener already set; repeat call is ignored`;
                return;
            }
            this.onAliasBound = true;
            flow.on('hyva:flow:on-lab', (event) => {
                store.log('api', `on() handler -> ${JSON.stringify(event.detail || {})}`);
            });

            this.snippet = `hyvaflow.on('hyva:flow:on-lab', (event) => {
  console.log(event.detail);
});
// Use on() alias to subscribe to a Hyvä Flow event`;

            store.log('api', 'on() listening for hyva:flow:on-lab. Use trigger() to fire it.');
        },

        triggerOnAlias() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;
            const detail = { stamp: Date.now(), via: 'trigger' };
            flow.trigger('hyva:flow:on-lab', detail);

            this.snippet = `hyvaflow.trigger('hyva:flow:on-lab', {
  stamp: Date.now(),
  via: 'trigger',
});
// Trigger an event handled by on() listener`;

            store.log('api', `trigger('hyva:flow:on-lab') dispatched ${JSON.stringify(detail)}.`);
        },

        /* Selection & iteration */
        selectTargets() {
            this.withTargets((selection, _flow, store) => {
                selection.forEach((node, index) => {
                    setTimeout(() => store.highlight(node), index * 120);
                });
                store.log('api', `select('${this.sampleSelector}') matched ${selection.length} nodes.`);
            });

            this.snippet = `const selection = hyvaflow.select('[data-flow-target]');
// Select all public API demo targets`;
        },

        selectFirst() {
            this.withTargets((selection, _flow, store) => {
                const firstNode = selection.first();
                if (firstNode) {
                    store.highlight(firstNode);
                    store.log('api', `first() => ${firstNode.dataset.flowTarget || firstNode.tagName}`);
                } else {
                    store.log('api', 'first() returned undefined.');
                }
            });

            this.snippet = `const first = hyvaflow.select('[data-flow-target]').first();
// Get the first matching target node`;
        },

        runEach() {
            this.withTargets((selection, _flow, store) => {
                let index = 0;
                selection.each((node) => {
                    index += 1;
                    store.log('api', `each -> ${(node.dataset.flowTarget || node.tagName)} (#${index})`);
                });
            });

            this.snippet = `hyvaflow.select('[data-flow-target]').each((node, index) => {
  console.log(index, node);
});
// Iterate through selection using each() helper`;
        },

        runForEach() {
            this.withTargets((selection, _flow, store) => {
                selection.forEach((node, index) => {
                    store.log('api', `forEach -> ${(node.dataset.flowTarget || node.tagName)} (#${index + 1})`);
                });
            });

            this.snippet = `hyvaflow.select('[data-flow-target]').forEach((node, index) => {
  console.log(index, node);
});
// Iterate through selection using forEach()`;
        },

        toArrayList() {
            this.withTargets((selection, _flow, store) => {
                const nodes = selection.toArray();
                const names = nodes.map((node) => node.dataset.flowTarget || node.tagName);
                store.log('api', `toArray() => [${names.join(', ')}]`);
            });

            this.snippet = `const nodes = hyvaflow.select('[data-flow-target]').toArray();
// Convert Hyvä Flow selection into a plain array`;
        },

        /* Classes & attributes */
        checkHasClass() {
            this.withTargets((selection, _flow, store) => {
                const result = selection.hasClass('is-accent');
                store.log('api', `hasClass('is-accent') => ${result}`);
            });

            this.snippet = `const hasAccent = hyvaflow.select('[data-flow-target]').hasClass('is-accent');
// Test whether any target has the accent class applied`;
        },

        toggleAccentClass() {
            this.withTargets((selection, _flow, store) => {
                selection.toggleClass('is-accent');
                store.log('api', "toggleClass('is-accent') toggled accent borders.");
            });

            this.snippet = `hyvaflow.select('[data-flow-target]').toggleClass('is-accent');
// Toggle accent class across all targets`;
        },

        addSelectedClass() {
            this.withTargets((selection, _flow, store) => {
                selection.addClass('is-selected');
                store.log('api', "addClass('is-selected') applied.");
            });

            this.snippet = `hyvaflow.select('[data-flow-target]').addClass('is-selected');
// Mark all targets as selected`;
        },

        removeSelectedClass() {
            this.withTargets((selection, _flow, store) => {
                selection.removeClass('is-selected');
                store.log('api', "removeClass('is-selected') cleared selection.");
            });

            this.snippet = `hyvaflow.select('[data-flow-target]').removeClass('is-selected');
// Clear selection class from all targets`;
        },

        applyAppliedState() {
            this.withTargets((selection, _flow, store) => {
                this.applyToggle = !this.applyToggle;
                selection.apply('is-applied', this.applyToggle ? 1 : 0);
                store.log('api', `apply('is-applied', ${this.applyToggle}) executed.`);
            });

            this.snippet = `const toggle = true; // or false
hyvaflow.select('[data-flow-target]').apply('is-applied', toggle ? 1 : 0);
// Apply or remove a stateful class based on a numeric flag`;
        },

        cycleAttrState() {
            this.withTargets((selection, _flow, store) => {
                const states = ['idle', 'active', 'pending'];
                this.attrStep = (this.attrStep + 1) % states.length;
                const next = states[this.attrStep];
                selection.set('data-flow-state', next);
                this.refreshAttrBadges();
                store.log('api', `set('data-flow-state', '${next}') updated ${selection.length} nodes.`);
            });

            this.snippet = `const states = ['idle', 'active', 'pending'];
const next = states[step];
hyvaflow.select('[data-flow-target]').set('data-flow-state', next);
// Cycle through data-flow-state attribute on all targets`;
        },

        /* onEvent() */
        bindOnEvent() {
            this.withTargets((selection, _flow, store) => {
                if (this.onEventBound) {
                    store.log('api', 'onEvent(click) already attached to the tiles.');
                    this.snippet = `hyvaflow.select('[data-flow-target]').onEvent('click', handler);
// Click handler is already attached; no-op on repeat call`;
                    return;
                }
                this.onEventBound = true;
                selection.onEvent('click', (event) => {
                    const node = event.currentTarget || event.target;
                    if (node && node.classList) {
                        node.classList.toggle('is-selected');
                    }
                    store.highlight(node);
                    store.log('api', `onEvent(click) -> toggled ${(node && (node.dataset.flowTarget || node.tagName)) || 'node'}.`);
                });

                this.snippet = `hyvaflow.select('[data-flow-target]').onEvent('click', (event) => {
  const node = event.currentTarget || event.target;
  node.classList.toggle('is-selected');
});
// Attach delegated click handlers to each target via onEvent()`;

                store.log('api', 'onEvent(click) attached. Click a tile to trigger the handler.');
            });
        }
    }));

    /* ---------------- addDomListener Lab ---------------- */
    Alpine.data('hyvaFlowDomLab', () => ({
        domNodeCount: 0,
        domListenerBound: false,
        snippet: '',

        init() {
            const domArea = document.querySelector('[data-flow-dom-area]');
            if (domArea) {
                this.domNodeCount = domArea.querySelectorAll('.hyvaflow-dom-node').length;
            }
            this.snippet = `// Use addDomListener() to wire delegated listeners for .hyvaflow-dom-node
// Click "addDomListener()" to see the exact setup`;
        },

        describeDomNode(node) {
            if (!node) return 'node';
            if (node.dataset && node.dataset.node) return node.dataset.node;
            return (node.textContent || 'node').trim();
        },

        wireDomListener() {
            const store = Alpine.store('hyvaflowDemo');
            const flow = store.flow();
            if (!flow) return;

            if (this.domListenerBound) {
                store.log('dom', 'addDomListener already wired for .hyvaflow-dom-node.');
                this.snippet = `hyvaflow.addDomListener('select', '.hyvaflow-dom-node', handler);
hyvaflow.addDomListener('click', '.hyvaflow-dom-node', handler);
// DOM listeners are already wired; repeat call is a no-op`;
                return;
            }
            this.domListenerBound = true;

            flow.addDomListener('select', '.hyvaflow-dom-node', ({ target }) => {
                store.log('dom', `addDomListener(select) processed ${this.describeDomNode(target)}.`);
            });

            flow.addDomListener('click', '.hyvaflow-dom-node', (event) => {
                const target = event.target && event.target.closest('.hyvaflow-dom-node');
                if (target) {
                    store.highlight(target);
                    store.log('dom', `addDomListener(click) fired for ${this.describeDomNode(target)}.`);
                }
            });

            this.snippet = `hyvaflow.addDomListener('select', '.hyvaflow-dom-node', ({ target }) => {
  console.log('select', target);
});
hyvaflow.addDomListener('click', '.hyvaflow-dom-node', (event) => {
  const target = event.target.closest('.hyvaflow-dom-node');
  console.log('click', target);
});
// Add delegated DOM listeners that automatically bind to static + dynamic nodes`;

            store.log('dom', 'addDomListener wired. Click any .hyvaflow-dom-node or add a new one to test.');
        },

        addDomNode() {
            const store = Alpine.store('hyvaflowDemo');
            const domArea = document.querySelector('[data-flow-dom-area]');
            if (!domArea) {
                store.log('dom', 'DOM lab container not found.');
                return;
            }

            this.domNodeCount += 1;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'action secondary hyvaflow-dom-node rounded-full border border-slate-300 px-3 py-1 text-sm shadow-sm transition duration-200';
            btn.dataset.node = `dynamic-${this.domNodeCount}`;
            btn.textContent = `Dynamic ${this.domNodeCount}`;
            domArea.appendChild(btn);

            this.snippet = `const button = document.createElement('button');
button.type = 'button';
button.className = 'action secondary hyvaflow-dom-node ...';
button.dataset.node = 'dynamic-N';
button.textContent = 'Dynamic N';
area.appendChild(button);
// Dynamically add a new .hyvaflow-dom-node; addDomListener will pick it up`;

            store.log('dom', `Added ${this.describeDomNode(btn)}. addDomListener will bind automatically once wired.`);
        }
    }));
});
</script>
