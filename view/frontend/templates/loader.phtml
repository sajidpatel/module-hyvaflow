// Get the cart service URL using Magento's view file URL resolver
$cartServiceUrl = $block->getViewFileUrl('SajidPatel_CatalogUI::js/services/cart-service.js');
?>

<script>
// ============================================================================
// Alpine.js Cart Service Queue Component
// ============================================================================
function cartServiceQueue() {
    return {
        queue: [],
        queueIdCounter: 0,
        CART_SERVICE_URL: "<?= $block->escapeJs($block->escapeHtml($cartServiceUrl)) ?>",

        addToQueue() {
            this.queueIdCounter++;
            const product = {
                sku: `DEMO-${String(this.queueIdCounter).padStart(3, '0')}`,
                qty: Math.floor(Math.random() * 3) + 1
            };

            this.queue.push(product);
            this.log('queue', `Added ${product.sku} (qty: ${product.qty}) to queue. Total: ${this.queue.length}`);
        },

        async loadAndProcess() {
            if (this.queue.length === 0) {
                this.log('queue', 'Queue is empty! Add products first.');
                return;
            }

            const flow = window.hyvaflow;
            if (!flow?.loader) {
                this.log('error', 'HyvaFlow loader not available');
                return;
            }

            try {
                this.log('cart', `Loading cart service from: ${this.CART_SERVICE_URL}`);

                // Load the cart service
                await flow.loader.load({
                    url: this.CART_SERVICE_URL,
                    id: 'cart-service'
                });

                this.log('cart', 'Cart service loaded successfully!');

                // Check if cart service is available
                if (!window.services?.cart) {
                    this.log('error', 'Cart service loaded but window.services.cart is not available');
                    this.log('info', 'This is expected in the demo - in production, the cart service would initialize itself');

                    // Simulate processing for demo purposes
                    this.log('queue', `Processing ${this.queue.length} products from queue...`);

                    for (let i = 0; i < this.queue.length; i++) {
                        const product = this.queue[i];
                        setTimeout(() => {
                            this.log('queue', `[${i + 1}/${this.queue.length}] Processing ${product.sku} (qty: ${product.qty})`);
                        }, i * 100);
                    }

                    // Clear queue after "processing"
                    const count = this.queue.length;
                    setTimeout(() => {
                        this.queue = [];
                        this.log('queue', `Queue processed! Cleared ${count} items.`);
                    }, this.queue.length * 100 + 200);

                } else {
                    // Real implementation when cart service is available
                    this.log('queue', `Processing ${this.queue.length} products from queue...`);

                    const results = await Promise.allSettled(
                        this.queue.map(product =>
                            window.services.cart.addProduct(product)
                        )
                    );

                    results.forEach((result, index) => {
                        const product = this.queue[index];
                        if (result.status === 'fulfilled') {
                            this.log('cart', `✓ Added ${product.sku} to cart`);
                        } else {
                            this.log('error', `✗ Failed to add ${product.sku}: ${result.reason}`);
                        }
                    });

                    // Clear queue
                    const count = this.queue.length;
                    this.queue = [];
                    this.log('queue', `Queue cleared! Processed ${count} items.`);
                }

            } catch (err) {
                this.log('error', `Failed to load cart service: ${err.message}`);
            }
        },

        clearQueue() {
            const count = this.queue.length;
            this.queue = [];
            this.queueIdCounter = 0;
            this.log('queue', `Cleared ${count} items from queue.`);
        },

        log(channel, message) {
            const logEl = document.getElementById('loader-demo-log');
            if (!logEl) return;
            const ts = new Date().toLocaleTimeString();
            logEl.textContent = `[${ts}] [${channel}] ${message}\n` + logEl.textContent;
        }
    };
}
</script>

<script>
(() => {
    const logEl = document.getElementById('loader-demo-log');

    const logLine = (channel, message) => {
        if (!logEl) return;
        const ts = new Date().toLocaleTimeString();
        logEl.textContent = `[${ts}] [${channel}] ${message}\n` + logEl.textContent;
    };

    const getFlow = () => {
        const flow = window.hyvaflow;
        if (!flow) {
            logLine('error', 'window.hyvaflow is undefined. Ensure hyvaflow-core.js and hyvaflow-loader.js are loaded.');
            return null;
        }
        if (!flow.loader) {
            logLine('error', 'window.hyvaflow.loader is undefined. Ensure hyvaflow-loader.js is loaded after core.');
            return null;
        }
        return flow;
    };

    // Demo script URLs (using CDN examples)
    const DEMO_SCRIPTS = {
        lodash: 'https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js',
        moment: 'https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js',
        axios: 'https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js'
    };

    // Load single script
    document.getElementById('load-single-script')?.addEventListener('click', async () => {
        const flow = getFlow();
        if (!flow) return;

        try {
            logLine('loader', `Loading: ${DEMO_SCRIPTS.lodash}`);
            await flow.loader.load({
                url: DEMO_SCRIPTS.lodash,
                id: 'lodash'
            });
            logLine('loader', 'Successfully loaded lodash!');
            if (typeof window._ !== 'undefined') {
                logLine('loader', `Lodash version: ${window._.VERSION}`);
            }
        } catch (err) {
            logLine('error', `Failed to load: ${err.message}`);
        }
    });

    // Check if loaded
    document.getElementById('check-loaded')?.addEventListener('click', () => {
        const flow = getFlow();
        if (!flow) return;

        const isLoaded = flow.loader.isLoaded('lodash');
        logLine('loader', `Is 'lodash' loaded? ${isLoaded}`);

        if (isLoaded && typeof window._ !== 'undefined') {
            logLine('loader', `Confirmed: window._ exists (version ${window._.VERSION})`);
        }
    });

    // Load with dependencies
    document.getElementById('load-with-deps')?.addEventListener('click', async () => {
        const flow = getFlow();
        if (!flow) return;

        try {
            logLine('loader', 'Loading queue with dependencies...');
            await flow.loader.loadQueue([
                { url: DEMO_SCRIPTS.moment, id: 'moment' },
                { url: DEMO_SCRIPTS.axios, id: 'axios', deps: ['moment'] }
            ]);
            logLine('loader', 'Queue loaded successfully!');

            if (typeof window.moment !== 'undefined') {
                logLine('loader', `Moment.js version: ${window.moment.version}`);
            }
            if (typeof window.axios !== 'undefined') {
                logLine('loader', `Axios version: ${window.axios.VERSION}`);
            }
        } catch (err) {
            logLine('error', `Queue loading failed: ${err.message}`);
        }
    });

    // List all loaded
    document.getElementById('list-loaded')?.addEventListener('click', () => {
        const flow = getFlow();
        if (!flow) return;

        const loaded = flow.loader.getLoaded();
        if (loaded.length === 0) {
            logLine('loader', 'No scripts loaded yet.');
        } else {
            logLine('loader', `Loaded scripts: ${loaded.join(', ')}`);
        }
    });

    // Register event listeners
    let listenersRegistered = false;
    document.getElementById('register-listeners')?.addEventListener('click', () => {
        const flow = getFlow();
        if (!flow) return;

        if (listenersRegistered) {
            logLine('event', 'Listeners already registered.');
            return;
        }

        flow.on('hyva:flow:loader:start', (e) => {
            logLine('event', `[loader:start] ${e.detail.id || e.detail.url}`);
        });

        flow.on('hyva:flow:loader:complete', (e) => {
            logLine('event', `[loader:complete] ${e.detail.id} loaded successfully`);
        });

        flow.on('hyva:flow:loader:error', (e) => {
            logLine('event', `[loader:error] ${e.detail.id} failed: ${e.detail.error?.message}`);
        });

        listenersRegistered = true;
        logLine('event', 'Event listeners registered for loader lifecycle events.');
    });

    // Clear log
    document.getElementById('clear-log')?.addEventListener('click', () => {
        if (logEl) {
            logEl.textContent = '';
            logLine('system', 'Log cleared.');
        }
    });

    // Initial log
    if (getFlow()) {
        logLine('system', 'HyvaFlow Loader demo initialized. Click buttons above to test the API.');
    }
})();
</script>
