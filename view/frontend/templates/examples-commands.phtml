            if (countBadge) {
                countBadge.textContent = total.items;
                countBadge.classList.add('animate-pulse');
            }

            // Send analytics event
            window.hyvaflow.trigger('analytics:track', {
                event: 'add_to_cart',
                productId: productId,
                quantity: quantity
            });
        });

