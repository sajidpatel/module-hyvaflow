<!--
    Hyvä Flow - Simple Usage Examples
    This template demonstrates each Hyvä Flow command with practical examples
-->

<div class="mx-auto p-6 font-sans">
    <h1 class="text-2xl font-bold mb-6 text-gray-800">2 Hyvä Flow - Command Examples</h1>

    <!-- Example 1: on() - Subscribe to events -->
    <section class="mb-8 p-4 border rounded-lg bg-blue-50">
        <h2 class="text-xl font-semibold mb-3 text-blue-600">1. on() - Subscribe to Events</h2>
        <pre class="bg-gray-900 text-green-400 p-4 rounded text-sm mb-3 overflow-x-auto">
// Listen for custom events
window.hyvaflow.on('user:login', function(event) {
    console.log('User logged in:', event.detail);
});

// Listen for DOM events
window.hyvaflow.on('click', function(event) {
    console.log('Element clicked:', event.target);
});
        </pre>
        <div class="mt-2 p-3 bg-white rounded">
            <button id="test-on-btn" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                Trigger Test Event (on())
            </button>
            <div id="on-output" class="mt-3 p-2 bg-gray-100 rounded text-sm">Event output will appear here...</div>
        </div>
    </section>

    <!-- Example 2: trigger() - Emit events -->
    <section class="mb-8 p-4 border rounded-lg bg-green-50">
        <h2 class="text-xl font-semibold mb-3 text-green-600">2. trigger() - Emit Events</h2>
        <pre class="bg-gray-900 text-green-400 p-4 rounded text-sm mb-3 overflow-x-auto">
// Emit custom events
element.addEventListener('click', function() {
    window.hyvaflow.trigger('button:clicked', {
        buttonText: this.textContent,
        timestamp: Date.now()
    });
});

// Send data to Alpine components
window.hyvaflow.trigger('cart:updated', {
    items: 5,
    total: 149.99
});
        </pre>
        <div class="mt-2 p-3 bg-white rounded">
            <button id="test-trigger-btn" class="px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600">
                Trigger Event (trigger())
            </button>
            <button id="alpine-trigger-btn" class="px-4 py-2 bg-purple-500 text-white rounded hover:bg-purple-600 ml-2">
                Send to Alpine (trigger())
            </button>
            <div id="trigger-output" class="mt-3 p-2 bg-gray-100 rounded text-sm">Trigger output will appear here...</div>
        </div>
    </section>

    <!-- Example 3: select() - DOM queries -->
    <section class="mb-8 p-4 border rounded-lg bg-yellow-50">
        <h2 class="text-xl font-semibold mb-3 text-yellow-600">3. select() - DOM Queries</h2>
        <pre class="bg-gray-900 text-green-400 p-4 rounded text-sm mb-3 overflow-x-auto">
// Select elements by CSS selector
const buttons = window.hyvaflow.select('button');
const inputs = window.hyvaflow.select('input[type="text"]');
const products = window.hyvaflow.select('.product-item');

// Process selected elements
buttons.forEach(btn => {
    btn.addEventListener('click', handler);
});
        </pre>
        <div class="mt-2 p-3 bg-white rounded">
            <div class="demo-select-container space-y-2 mb-4">
                <button class="select-demo-btn px-3 py-1 bg-gray-200 rounded text-sm">Demo Button 1</button>
                <button class="select-demo-btn px-3 py-1 bg-gray-200 rounded text-sm">Demo Button 2</button>
                <button class="select-demo-btn px-3 py-1 bg-gray-200 rounded text-sm">Demo Button 3</button>
            </div>

            <button id="test-select-btn" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600">
                Select and Highlight (.select())
            </button>
            <div id="select-output" class="mt-3 p-2 bg-gray-100 rounded text-sm">Select output will appear here...</div>
        </div>
    </section>

    <!-- Example 4: Ready state (Alpine integration) -->
    <section class="mb-8 p-4 border rounded-lg bg-indigo-50">
        <h2 class="text-xl font-semibold mb-3 text-indigo-600">4. ready() - Wait for Alpine</h2>
        <pre class="bg-gray-900 text-green-400 p-4 rounded text-sm mb-3 overflow-x-auto">
// Wait for Alpine.js to be ready (useful for delayed scripts)
window.hyvaflow.ready().then(() => {
    console.log('Alpine is ready!');

    // Now it's safe to interact with Alpine components
    window.hyvaflow.trigger('data:loaded', {
        ready: true
    });
});
        </pre>
        <div class="mt-2 p-3 bg-white rounded">
            <button id="test-ready-btn" class="px-4 py-2 bg-indigo-500 text-white rounded hover:bg-indigo-600">
                Test Ready State (ready())
            </button>
            <div id="ready-output" class="mt-3 p-2 bg-gray-100 rounded text-sm">Ready state output will appear here...</div>
        </div>
    </section>

    <!-- Example 5: Cleanup events -->
    <section class="mb-8 p-4 border rounded-lg bg-red-50">
        <h2 class="text-xl font-semibold mb-3 text-red-600">5. off() - Remove Event Listeners</h2>
        <pre class="bg-gray-900 text-green-400 p-4 rounded text-sm mb-3 overflow-x-auto">
// Store event handler reference
const clickHandler = function(event) {
    console.log('Clicked!', event.target);
};

// Add event listener
window.hyvaflow.on('click', clickHandler);

// Later, remove it when cleaning up
window.hyvaflow.off('click', clickHandler);
        </pre>
        <div class="mt-2 p-3 bg-white rounded">
            <button id="enable-cleanup-btn" class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600">
                Enable Click Handler (on())
            </button>
            <button id="disable-cleanup-btn" class="px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 ml-2">
                Disable Click Handler (off())
            </button>

            <p id="cleanup-status" class="mt-3 text-sm">Click handler is NOT active</p>
            <p class="text-sm text-gray-600 mt-2">Tip: Try clicking around the page after enabling</p>
        </div>
    </section>

    <!-- Complete Example: Real-world usage -->
    <section class="mb-8 p-4 border rounded-lg bg-gray-50">
        <h2 class="text-xl font-semibold mb-3 text-gray-700">6. Complete Example: Shopping Cart</h2>
        <pre class="bg-gray-900 text-green-400 p-4 rounded text-sm mb-3 overflow-x-auto">
