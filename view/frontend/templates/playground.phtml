    transform: translateY(-1px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.32);
}
.hyvaflow-playground .action:active {
    transform: translateY(0);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28);
}
.hyvaflow-playground .action:disabled,
.hyvaflow-playground .action[disabled] {
    opacity: 0.6;
