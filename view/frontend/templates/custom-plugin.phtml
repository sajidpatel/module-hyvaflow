<script>
(() => {
    const logEl = document.getElementById('customplugin-log');
    const installBtn = document.getElementById('customplugin-install');
    const triggerBtn = document.getElementById('customplugin-trigger');
    const clearBtn = document.getElementById('customplugin-log-clear');
    const listBtn = document.getElementById('customplugin-list-plugins');
    const prefixInput = document.getElementById('customplugin-prefix');
    let emitCount = 0;

    const logLine = (message) => {
        if (!logEl) return;
        const now = new Date().toLocaleTimeString();
        logEl.textContent = `[${now}] ${message}\n` + logEl.textContent;
    };

    const pluginDefinition = {
        name: 'customplugin-guide',
        defaults: { prefix: 'Flow.use plugin' },
        initializer: ({ core, setInstance }, options = {}) => {
            const resolved = { ...pluginDefinition.defaults, ...options };
            const channel = core.ns('customplugin:guide:announce');

            const handler = (event) => {
                if (event?.detail) {
                    console.log('[customplugin-guide]', event.detail);
                }
            };

            core.on(channel, handler);

            const instance = window.hyvaflow || core;
            instance.customPluginGuide = {
                options: resolved,
                emit(message) {
                    core.trigger(channel, {
                        message,
                        prefix: resolved.prefix,
                        ts: Date.now(),
                    });
                },
            };
            setInstance(instance);

            core.trigger(core.ns('customplugin:guide:ready'), { plugin: pluginDefinition.name, options: resolved });

            return () => core.off(channel, handler);
        },
    };

    const ensureFlow = () => {
        const flow = window.hyvaflow;
        if (!flow || typeof flow.use !== 'function') {
            logLine('window.hyvaflow.use() is not available. Ensure hyvaflow-core.js is loaded.');
            return null;
        }
        return flow;
    };

    const installPlugin = () => {
        const flow = ensureFlow();
        if (!flow) return;

        if (flow.plugins?.isRegistered?.(pluginDefinition.name)) {
            logLine('Plugin already installed; reusing existing instance.');
            triggerBtn?.removeAttribute('disabled');
            return;
        }

        const prefix = (prefixInput?.value || '').trim() || pluginDefinition.defaults.prefix;
        flow.use(pluginDefinition, { prefix });
        triggerBtn?.removeAttribute('disabled');
        logLine(`Registered "${pluginDefinition.name}" via flow.use() with prefix "${prefix}".`);
    };

    const emitMessage = () => {
        const flow = ensureFlow();
        if (!flow || !flow.customPluginGuide?.emit) {
            logLine('Install the plugin first to expose flow.customPluginGuide.emit().');
            return;
        }
        emitCount += 1;
        flow.customPluginGuide.emit(`Hello from the plugin guide #${emitCount}`);
    };

    const listPlugins = () => {
        const flow = ensureFlow();
        if (!flow) return;
        const names = (flow.plugins?.list?.() || []).join(', ') || 'none';
        logLine(`Registered plugins: ${names}`);
    };

    const attachListeners = () => {
        const flow = ensureFlow();
        if (!flow) return;

        const channel = flow.ns('customplugin:guide:announce');
        flow.on(channel, (event) => {
            const detail = event?.detail || {};
            const message = detail.message || 'No message';
            const prefix = detail.prefix || 'flow.use';
            const when = detail.ts ? new Date(detail.ts).toLocaleTimeString() : 'now';
            logLine(`${prefix} → ${message} (${when})`);
        });

        flow.on(flow.ns('customplugin:guide:ready'), (event) => {
            const opts = event?.detail?.options || {};
            logLine(`customplugin-guide ready with options: ${JSON.stringify(opts)}`);
        });
    };

    const ready = () => {
        attachListeners();
        installBtn?.addEventListener('click', installPlugin);
        triggerBtn?.addEventListener('click', emitMessage);
        clearBtn?.addEventListener('click', () => { logEl.textContent = ''; });
        listBtn?.addEventListener('click', listPlugins);
    };

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        ready();
    } else {
        document.addEventListener('DOMContentLoaded', ready, { once: true });
    }
})();
</script>
