<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('hyvaFlowPlayground', () => ({
        // Global
        snippet: '// Snippet output will appear here',
        log: '',

        // EventBus inspector
        eventBus: {
            listenersRegistered: false,
            lastEvent: null,
            lastDetail: null
        },

        // Trigger inspector
        triggerEventName: 'hyva:flow:demo',
        triggerDetailSource: '{ "from": "playground" }',
        triggerLast: null,

        // select() inspector
        selectSelector: '[data-select-target]',
        selectLastCount: 0,
        selectLastNodes: [],

        // HTMX inspector
        htmxLastEvent: null,
        htmxCount: 0,

        // DOM Lab
        domNodeCount: 2,
        domListenerBound: false,
        eventQueue: [],
        timeline: [],
        processing: false,
        supportedEvents: ['click', 'dblclick', 'input', 'change'],

        init() {
            this.logMsg('Hyvä Flow Playground ready.');

            const area = document.querySelector('[data-lab-area]');
            if (area) {
                this.domNodeCount = area.querySelectorAll('.lab-node').length;
            }

            // Multi-event queue: capture before listeners exist
            this.supportedEvents.forEach((ev) => {
                document.addEventListener(ev, (e) => {

                    // Only queue EVENTS FROM PRIMARY BUTTON
                    if (ev === 'click' && e.button !== 0) return;

                    const node = e.target.closest('.lab-node, .hyvaflow-dom-node');
                    if (!node) return;

                    // Prevent double-queue when bubbling or synthetic re-dispatch
                    if (e.__queued) return;
                    e.__queued = true;

                    // Prevent child node clicks being counted twice
                    if (e.target !== node && ev === 'click') return;

                    const nodeName = node.dataset.node || (node.textContent || '').trim() || 'node';

                    this.eventQueue.push({
                        type: ev,
                        node: nodeName,
                        timestamp: Date.now()
                    });

                    this.timeline.push({ step: 'queued', event: ev, node: nodeName });
                    this.logMsg(`Queued ${ev} on ${nodeName}`);

                }, true);
            });

        },

        /* Helpers */
        logMsg(msg) {
            const ts = new Date().toLocaleTimeString();
            this.log = `[${ts}] ${msg}\n` + this.log;
        },

        flow() {
            const f = window.hyvaflow;
            if (!f) {
                this.logMsg('❌ window.hyvaflow is undefined. Ensure hyvaflow-core.js is loaded.');
            }
            return f;
        },

        highlight(node) {
            if (!node || !node.classList) return;
            node.classList.add('ring-2', 'ring-emerald-400', 'shadow-md');
            setTimeout(() => {
                node.classList.remove('ring-2', 'ring-emerald-400', 'shadow-md');
            }, 500);
        },

        /* EVENT BUS */
        registerListeners() {
            const f = this.flow();
            if (!f) return;

            if (this.eventBus.listenersRegistered) {
                this.logMsg('EventBus listeners already registered.');
                this.snippet =
`hyvaflow.on('hyva:flow:ready', handler);
hyvaflow.on('hyva:flow:dom:refresh', handler);
hyvaflow.on('hyva:flow:demo', handler);
// EventBus listeners already active; no-op on repeat call`;
                return;
            }

            this.eventBus.listenersRegistered = true;

            f.on('hyva:flow:ready', (event) => {
                this.eventBus.lastEvent = 'hyva:flow:ready';
                this.eventBus.lastDetail = event?.detail || {};
                this.logMsg('hyva:flow:ready received.');
            });

            f.on('hyva:flow:dom:refresh', (event) => {
                this.eventBus.lastEvent = 'hyva:flow:dom:refresh';
                this.eventBus.lastDetail = event?.detail || {};
                this.logMsg('hyva:flow:dom:refresh received.');
            });

            f.on('hyva:flow:demo', (event) => {
                this.eventBus.lastEvent = 'hyva:flow:demo';
                this.eventBus.lastDetail = event?.detail || {};
                this.logMsg('hyva:flow:demo => ' + JSON.stringify(event?.detail || {}));
            });

            this.snippet =
`hyvaflow.on('hyva:flow:ready', (event) => {
  console.log('ready', event.detail);
});
hyvaflow.on('hyva:flow:dom:refresh', () => {
  console.log('dom:refresh');
});
hyvaflow.on('hyva:flow:demo', (event) => {
  console.log('demo', event.detail);
});
// Register Hyvä Flow event bus listeners`;
            this.logMsg('EventBus listeners registered.');
        },

        triggerDemoFromEventBus() {
            const f = this.flow();
            if (!f) return;

            const detail = {
                source: 'event-bus-section',
                at: Date.now(),
                note: 'Triggered from EventBus section'
            };

            f.trigger('hyva:flow:demo', detail);

            this.snippet =
`hyvaflow.trigger('hyva:flow:demo', {
  source: 'event-bus-section',
  at: Date.now(),
  note: 'Triggered from EventBus section',
});
// Trigger Hyvä Flow demo event`;

            this.logMsg('Triggered hyva:flow:demo from EventBus section.');
        },

        emitReady() {
            document.dispatchEvent(new CustomEvent('alpine:init'));
            this.snippet =
`document.dispatchEvent(new CustomEvent('alpine:init'));
// Stimulate Alpine init; Hyvä Flow can derive hyva:flow:ready from this`;
            this.logMsg('alpine:init dispatched.');
        },

        emitRefresh() {
            const f = this.flow();
            if (!f) return;
            f.trigger('hyva:flow:dom:refresh');

            this.snippet =
`hyvaflow.trigger('hyva:flow:dom:refresh');
// Manually trigger DOM refresh lifecycle event`;
            this.logMsg('hyva:flow:dom:refresh triggered.');
        },

        /* TRIGGER INSPECTOR */
        runTriggerInspector() {
            const f = this.flow();
            if (!f) return;

            const name = (this.triggerEventName || '').trim() || 'hyva:flow:demo';
            let detail;
            let error = null;

            const raw = this.triggerDetailSource || '';

            if (!raw.trim()) {
                detail = {};
            } else {
                try {
                    detail = JSON.parse(raw);
                } catch (e) {
                    detail = raw;
                    error = 'Detail is not valid JSON; sent as string.';
                }
            }

            f.trigger(name, detail);
            this.triggerLast = { name, detail, error };

            this.snippet =
`let detail;
try {
  detail = JSON.parse('<?= addslashes('{ "from": "playground" }') ?>');
} catch {
  detail = '<?= addslashes('{ "from": "playground" }') ?>';
}
hyvaflow.trigger('${name}', detail);
// Trigger arbitrary Hyvä Flow event from UI`;

            this.logMsg(`Triggered ${name} via trigger inspector.`);
        },

        /* select() INSPECTOR */
        runSelect() {
            const f = this.flow();
            if (!f) return;

            const selection = f.select(this.selectSelector);
            const nodes = selection?.toArray ? selection.toArray() : Array.from(selection || []);

            this.selectLastCount = nodes.length;
            this.selectLastNodes = nodes.map((node) => ({
                id: node.dataset?.selectId || node.getAttribute('data-select-id') || node.tagName.toLowerCase(),
                tag: node.tagName.toLowerCase()
            }));

            nodes.forEach((node) => this.highlight(node));

            this.snippet =
`const nodes = hyvaflow.select('${this.selectSelector}').toArray();
// Run a Hyvä Flow selection and inspect results`;

            this.logMsg(`select('${this.selectSelector}') matched ${nodes.length} node(s).`);
        },

        runFirst() {
            const f = this.flow();
            if (!f) return;
            const selection = f.select(this.selectSelector);
            const first = selection?.first ? selection.first() : (selection ? selection[0] : null);

            this.selectLastCount = first ? 1 : 0;
            this.selectLastNodes = first ? [{
                id: first.dataset?.selectId || first.getAttribute('data-select-id') || first.tagName.toLowerCase(),
                tag: first.tagName.toLowerCase()
            }] : [];

            if (first) this.highlight(first);

            this.snippet =
`const first = hyvaflow.select('${this.selectSelector}').first();
// Get the first matching node from the selection`;

            this.logMsg(first ? 'first() returned one node.' : 'first() returned undefined.');
        },

        runToArray() {
            const f = this.flow();
            if (!f) return;
            const selection = f.select(this.selectSelector);
            const nodes = selection?.toArray ? selection.toArray() : Array.from(selection || []);

            this.selectLastCount = nodes.length;
            this.selectLastNodes = nodes.map((node) => ({
                id: node.dataset?.selectId || node.getAttribute('data-select-id') || node.tagName.toLowerCase(),
                tag: node.tagName.toLowerCase()
            }));

            this.snippet =
`const nodes = hyvaflow.select('${this.selectSelector}').toArray();
// Convert Hyvä Flow selection wrapper into a plain array`;

            this.logMsg(`toArray() produced ${nodes.length} node(s).`);
        },

        /* HTMX INSPECTOR */
        simulateHtmx(eventName) {
            const detail = {
                from: 'playground',
                at: Date.now()
            };

            document.dispatchEvent(new CustomEvent(eventName, { detail }));
            this.htmxLastEvent = eventName;
            this.htmxCount += 1;

            this.snippet =
`document.dispatchEvent(new CustomEvent('${eventName}', {
  detail: { from: 'playground', at: Date.now() }
}));
// Simulate HTMX lifecycle event`;

            this.logMsg(`Simulated ${eventName}.`);
        },

        /* DOM LAB: addDomListener + QUEUE + TIMELINE */
        async replayQueuedEvents() {
            if (this.processing) return;
            const queue = this.eventQueue.slice();
            if (!queue.length) {
                this.logMsg('No queued events to replay.');
                return;
            }

            this.processing = true;
            this.logMsg(`Replaying ${queue.length} queued event(s)...`);

            for (let i = 0; i < queue.length; i++) {
                const ev = queue[i];
                const node = document.querySelector('[data-node="' + ev.node + '"]');

                this.timeline.push({ step: 'replaying', event: ev.type, node: ev.node });

                if (node) {
                    this.highlight(node);
                    this.logMsg(`(replayed) ${ev.type} on ${ev.node}`);
                } else {
                    this.logMsg(`(replayed) ${ev.type} on ${ev.node} (node not found)`);
                }

                await new Promise((resolve) => setTimeout(resolve, 250));
            }

            this.eventQueue = [];
            this.timeline.push({ step: 'done', event: null, node: null });
            this.processing = false;
        },

        wireDomListeners() {
            const f = this.flow();
            if (!f) return;

            if (this.domListenerBound) {
                this.logMsg('addDomListener already wired.');
                this.snippet =
`// addDomListener already wired:
hyvaflow.addDomListener('click', '.lab-node', handler);`;
                return;
            }

            this.domListenerBound = true;

            this.supportedEvents.forEach((ev) => {
                f.addDomListener(ev, '.lab-node, .hyvaflow-dom-node', (event) => {
                    const target = event.target.closest('.lab-node, .hyvaflow-dom-node');
                    if (!target) return;
                    const nodeName = target.dataset.node || (target.textContent || '').trim() || 'node';
                    this.highlight(target);
                    this.timeline.push({ step: 'handled', event: ev, node: nodeName });
                    this.logMsg(`addDomListener(${ev}) fired for ${nodeName}`);
                });
            });

            this.snippet =
`['click','dblclick','input','change'].forEach((ev) => {
  hyvaflow.addDomListener(ev, '.lab-node, .hyvaflow-dom-node', (event) => {
    const node = event.target.closest('.lab-node, .hyvaflow-dom-node');
    console.log(ev, node?.dataset.node);
  });
});
// Wire Hyvä Flow DOM listeners for multiple events`;

            this.logMsg('addDomListener wired for click/dblclick/input/change.');
            this.replayQueuedEvents();
        },

        addDomNode() {
            const area = document.querySelector('[data-lab-area]');
            if (!area) {
                this.logMsg('DOM lab area not found.');
                return;
            }

            this.domNodeCount += 1;
            const id = 'dynamic-' + this.domNodeCount;

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'action secondary lab-node rounded-full border border-slate-300 px-3 py-1 text-sm shadow-sm transition duration-200';
            btn.dataset.node = id;
            btn.textContent = 'Dynamic ' + this.domNodeCount;

            area.appendChild(btn);

            this.snippet =
`const btn = document.createElement('button');
btn.type = 'button';
btn.classList.add('lab-node');
btn.dataset.node = '${id}';
area.appendChild(btn);
// Dynamically add a lab node; addDomListener() will include it automatically`;

            this.logMsg('Added lab node ' + id + '.');
        }
    }));
});
</script>

<style>
/* Tiny helper for the timeline pulse (if Tailwind not configured for animate-pulse) */
.animate-pulse {
    animation: hf-pulse 0.9s linear infinite;
}
@keyframes hf-pulse {
    0% { opacity: 0.4; }
    50% { opacity: 1; }
    100% { opacity: 0.4; }
}
</style>
