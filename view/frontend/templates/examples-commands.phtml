        // Listen for cart updates from Alpine components
        window.hyvaflow.on('cart:item:added', function(event) {
            const { productId, quantity, total } = event.detail;

            // Update UI elements
            const cartIcon = window.hyvaflow.select('.cart-icon')[0];
