}
        </pre>
        <div class="mt-4 p-4 bg-white rounded border">
            <div class="flex items-center justify-between p-3 bg-blue-50 rounded">
                <span class="font-semibold text-blue-800">Shopping Cart (Demo)</span>
                <span class="cart-icon font-bold text-blue-600">🛒 Cart: <span class="cart-count bg-blue-600 text-white px-2 py-1 rounded-full text-sm">0</span></span>
            </div>
        </div>
    </section>
</div>

<!-- JavaScript for interactive examples -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    let clickHandler = null; // For off() example
    let eventHandler = null; // For on() example

    // on() example - Subscribe to events
    document.getElementById('test-on-btn').addEventListener('click', () => {
        if (!eventHandler) {
            eventHandler = function(event) {
                const output = document.getElementById('on-output');
                output.textContent = `[${new Date().toLocaleTimeString()}] Received: ${JSON.stringify(event.detail)}`;
            };
            window.hyvaflow.on('hyva-test-event', eventHandler);
        }

        console.log('[Demo] Click handler registered');
        document.getElementById('on-output').textContent = 'Event listener registered - now processing events';
    });

    // trigger() example - Emit events
    document.getElementById('test-trigger-btn').addEventListener('click', () => {
        window.hyvaflow.trigger('hyva-test-event', {
            source: 'trigger button',
            message: 'Hello from trigger!',
            timestamp: Date.now()
        });
        document.getElementById('trigger-output').textContent = 'Event triggered!';
    });

    document.getElementById('alpine-trigger-btn').addEventListener('click', () => {
        window.hyvaflow.trigger('cart:updated', { items: 3, total: 99.97 });
        document.getElementById('trigger-output').textContent = 'Alpine event triggered!';

        // Update cart demo
        document.querySelector('.cart-count').textContent = '3';
    });

    // select() example - DOM queries
    document.getElementById('test-select-btn').addEventListener('click', () => {
        const buttons = window.hyvaflow.select('.select-demo-btn');
        document.getElementById('select-output').textContent = `Selected ${buttons.length} buttons`;

        // Highlight them
        buttons.forEach(btn => {
            btn.style.backgroundColor = '#fbbf24';
            btn.style.color = '#000';
            setTimeout(() => {
                btn.style.backgroundColor = '';
                btn.style.color = '';
            }, 2000);
        });
    });

    // ready() example - Wait for Alpine
    document.getElementById('test-ready-btn').addEventListener('click', async () => {
        const output = document.getElementById('ready-output');
        output.textContent = 'Checking Alpine ready state...';

        if (!window.hyvaflow.ready) {
            output.textContent = 'Hyvä Flow ready() not available';
            return;
        }

        await window.hyvaflow.ready();

        output.textContent = 'Alpine is ready! (We can now safely interact with Alpine components)';

        // Trigger a demo Alpine event
        window.hyvaflow.trigger('ready-demo-event', { ready: true });
    });

    // off() example - Remove listeners
    function enableClickHandler() {
        if (!clickHandler) {
            clickHandler = (event) => {
                if (Math.random() > 0.8) {
                    console.log('[Demo] Click detected via Hyvä Flow:', event.target);
                }
            };
            window.hyvaflow.on('click', clickHandler);
            document.getElementById('cleanup-status').textContent = 'Click handler is ACTIVE';
        }
    }

    function disableClickHandler() {
        if (clickHandler) {
            window.hyvaflow.off('click', clickHandler);
            clickHandler = null;
            document.getElementById('cleanup-status').textContent = 'Click handler is NOT active';
        }
    }

    document.getElementById('enable-cleanup-btn').addEventListener('click', enableClickHandler);
    document.getElementById('disable-cleanup-btn').addEventListener('click', disableClickHandler);

    // Log readiness
    console.log('✅ Hyvä Flow Command Examples loaded');
});
</script>